.atlas {
  left: 0;
  top: 0;
  width: 140;
  height: 100%;

  .atlas-scroll {
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    padding: 8 4 8 8;

    Scrollbar {
      width: 3;
    }
  }

  .atlas-content {
    width: 100%;
    height: fit-content;
    space-between-entries: 2;
    padding-right: 4;
  }

  .atlas-title {
    font-size: 1;
    text-color: white;
  }

  .atlas-subtitle {
    font-size: 0.7;
    text-color: rgb(138, 150, 143);
    margin-bottom: 2;
  }

  .atlas-label {
    font-size: 0.6;
    text-color: rgb(125, 137, 131);
    margin-top: 7;
    margin-bottom: 1;
  }

  .atlas-empty {
    font-size: 0.7;
    text-color: rgb(125, 137, 131);
    margin-top: 2;
  }

  .atlas-tabs {
    renderer: "Background";
    width: 100%;
    height: 15;
    orientation: horizontal;
    space-between-entries: 1;
    padding: 1;
    background-color: rgb(26, 33, 30);
    border-radius: 3;
  }

  .atlas-tab {
    renderer: "Background";
    height: 100%;
    border-radius: 2;

    &:hover {
      background-color: rgba(42, 53, 48, 150);
    }

    Component {
      left: 50%;
      top: 50%;
      alignment-x: center;
      alignment-y: center;
      font-size: 0.65;
      text-color: rgb(138, 150, 143);
    }
  }

  .atlas-tab-active {
    background-color: rgb(42, 53, 48);

    Component {
      text-color: white;
    }
  }

  .atlas-row {
    renderer: "Background";
    width: 100%;
    height: 14;
    border-radius: 2;

    &:hover {
      background-color: rgba(28, 38, 34, 200);
    }

    .atlas-row-name {
      left: 3;
      top: 50%;
      alignment-y: center;
      font-size: 0.75;
    }

    .atlas-row-name-indented {
      left: 13;
    }

    .atlas-row-icon {
      left: 3;
      top: 50%;
      alignment-y: center;
      width: 7;
      height: 7;
    }

    .atlas-row-detail {
      right: 3;
      top: 50%;
      alignment-y: center;
      font-size: 0.6;
      text-color: rgb(125, 137, 131);
    }

    .atlas-toggle {
      right: 3;
      top: 50%;
      alignment-y: center;
      width: 16;
      height: 8;
    }
  }

  .atlas-row-active {
    background-color: rgb(28, 38, 34);
  }

  .atlas-search {
    width: 100%;
    height: 14;
    margin-bottom: 2;
    padding: 3 3 0 3;
    font-size: 0.75;
    background-color: rgb(26, 33, 30);
    border-radius: 2;
  }
}

.atlas-handle {
  left: 140;
  top: 50%;
  alignment-y: center;
  width: 9;
  height: 30;

  Icon {
    left: 50%;
    top: 50%;
    alignment-x: center;
    alignment-y: center;
    width: 5;
    height: 5;
  }
}
