@import super();

.atlas {
  .atlas-subtitle {
    font-size: 0.7;
    text-color: rgb(160, 160, 160);
  }

  .atlas-label {
    font-size: 0.6;
    text-color: rgb(125, 125, 125);
  }

  .atlas-empty {
    font-size: 0.7;
    text-color: rgb(125, 125, 125);
  }

  .atlas-title, .atlas-tab-active Component {
    text-color: rgb(241, 241, 241);
  }

  .atlas-tabs {
    background-color: rgba(0, 0, 0, 80);
    border-radius: 4;
  }

  .atlas-tab {
    border-radius: 3;

    Component {
      font-size: 0.65;
    }

    &:hover {
      background-color: var(--button-color-hover);
    }
  }

  .atlas-tab-active {
    background-color: var(--button-color-active);
  }

  .atlas-row {
    border-radius: 3;

    .atlas-row-name {
      font-size: 0.75;
    }

    .atlas-row-detail {
      font-size: 0.6;
      text-color: rgb(160, 160, 160);
    }

    &:hover {
      background-color: rgba(147, 153, 156, 40);
    }
  }

  .atlas-row-active {
    background-color: rgba(180, 180, 180, 80);
  }

  .atlas-search {
    font-size: 0.75;
    border-radius: 3;
  }
}
